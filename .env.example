# Application
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dameesco

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_me
JWT_REFRESH_SECRET=your_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Frontend and CORS
# Public frontend origin used to generate links in emails. Must be one HTTP(S) URL.
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed browser origins. Use * only when intentionally allowing all origins.
CORS_ORIGINS=http://localhost:3000

# Admin seed
ADMIN_EMAIL=admin@dameesco.com
ADMIN_PASSWORD=ChangeMe123!
LICENSE_ADMIN_EMAIL=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BUCKET_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM_NAME=SUNAR
RESEND_FROM_EMAIL=no-reply@sunarmusic.ai
RESEND_FROM="SUNAR <no-reply@sunarmusic.ai>"

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dameesco <no-reply@dameesco.com>"

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
WATERMARK_AUDIO_PATH=./assets/watermark.wav
WATERMARK_DELAY_SECONDS=10
WATERMARK_DUCK_VOLUME=0.5

# Cyanite
CYANITE_API_KEY=
CYANITE_WEBHOOK_SECRET=
